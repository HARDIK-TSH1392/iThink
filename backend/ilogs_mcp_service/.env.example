PORT=8004
ITHINK_BACKEND_BASE_URL=http://127.0.0.1:8123/api/v1

# Optional. This service is exposed on a public tunnel URL that Agora's
# cloud calls directly -- unset means no auth check (fine for local-only
# dev). Set the same value here and as ILOGS_SHARED_SECRET in
# voice-agent/server/.env when running behind a public tunnel.
ILOGS_SHARED_SECRET=
