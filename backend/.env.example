# Copy this file to .env and fill in real values. .env is gitignored —
# everyone on the team keeps their own, this file just documents what's
# expected (see app/config.py:Settings for the authoritative list).

# SQLite is fine for local dev; leave as-is unless you have a real reason
# to point at Postgres.
DATABASE_URL=sqlite+aiosqlite:///./ithink_dev.db

# Required for iTriage (log -> incident triage) and iCall (live structuring
# during a call) to do anything beyond their fallback behavior. Get one at
# https://aistudio.google.com/apikey. Without it: iTriage's Gemini calls
# will fail (logged, not crash-worthy — check server logs), and iCall's
# structuring endpoint returns a fixed fallback line instead of real output.
GEMINI_API_KEY=

# From Agora Console -> Project -> notification config, generated when you
# register a webhook URL there. Registering one needs a public HTTPS URL,
# so this stays empty for local dev — the webhook receiver still works
# without it, just accepts requests unverified with a loud warning logged.
AGORA_WEBHOOK_SECRET=
