# Copy this file to .env and fill in real values. .env is gitignored —
# everyone on the team keeps their own, this file just documents what's
# expected (see app/config.py:Settings for the authoritative list).

# SQLite is fine for local dev; leave as-is unless you have a real reason
# to point at Postgres.
DATABASE_URL=sqlite+aiosqlite:///./ithink_dev.db

# Required for iTriage (log -> incident triage) and iCall (live structuring
# during a call) to do anything beyond their fallback behavior. Get one at
# https://aistudio.google.com/apikey. Without it: iTriage's Gemini calls
# will fail (logged, not crash-worthy — check server logs), and iCall's
# structuring endpoint returns a fixed fallback line instead of real output.
GEMINI_API_KEY=

# From Agora Console -> Project -> notification config, generated when you
# register a webhook URL there. Registering one needs a public HTTPS URL,
# so this stays empty for local dev — the webhook receiver still works
# without it, just accepts requests unverified with a loud warning logged.
AGORA_WEBHOOK_SECRET=

# --- iOrchestrate: Slack ---
# Incoming Webhook URL (api.slack.com/apps -> your app -> Incoming Webhooks
# -> Add New Webhook to Workspace). Powers channel posts: approval requests
# (fallback path), the approved-incident announcement, and the post-call
# summary. Without it, iOrchestrate logs a skip instead of posting.
SLACK_WEBHOOK_URL=

# Bot User OAuth Token (xoxb-..., under OAuth & Permissions once the app has
# the chat:write scope). Powers DMs to the specific resolved approver rather
# than posting to the shared channel. Falls back to SLACK_WEBHOOK_URL's
# channel post when unset or the approver has no Slack ID on file.
SLACK_BOT_TOKEN=

# Signing Secret (Basic Information -> App Credentials). Required to verify
# that interactive button clicks (Approve/Reject, Create Jira Ticket/Skip)
# actually came from Slack before acting on them.
SLACK_SIGNING_SECRET=

# --- iOrchestrate: Jira ---
# All four required together for ticket creation; missing any one logs a
# skip rather than a partial/broken attempt.
JIRA_SITE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
