AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate
PORT=8000

# iThink-specific, not part of the upstream Agora quickstart. Base URL of
# the iThink backend (the repo's backend/ service) — agent.py builds the
# per-channel custom-LLM URL from this: {base}/icall/channel/{channel}/llm/chat/completions.
# Defaults to http://127.0.0.1:8123/api/v1 if unset.
ITHINK_BACKEND_BASE_URL=http://127.0.0.1:8123/api/v1

# Override the full custom-LLM URL directly instead of deriving it from
# ITHINK_BACKEND_BASE_URL — leave unset unless you have a specific reason to.
ITHINK_LLM_URL=

# Static key sent as the CustomLLM api_key. iCall's endpoint doesn't check
# it today, so any placeholder value works — kept as a real setting rather
# than hardcoded "unused" so it's easy to wire up auth later without a
# code change.
ITHINK_LLM_API_KEY=unused

# --- Native Agora MCP tool-calling (see root README's "Native MCP
# tool-calling during a live call" section) ---
# Both optional and independent -- a tool is simply not registered with
# Agora when its var is unset, no crash either way.

# A GitHub personal access token. Registers GitHub's own official remote
# MCP server (api.githubcopilot.com/mcp/) directly with Agora, so the model
# can call it live during a call to answer questions about commits/deploys.
GITHUB_TOKEN=

# Public HTTPS URL of backend/ilogs_mcp_service/'s /mcp endpoint (that
# service must be running separately -- own .venv, own process -- and
# tunneled publicly, since Agora's cloud calls this directly, not
# localhost). Lets the model pull recent server logs for the incident's
# service live during the call.
ILOGS_MCP_URL=

# Optional. When set, enables Agora's native "generated" filler-words mode:
# a short, context-aware filler phrase spoken while the main LLM is still
# thinking, generated by a separate call to Gemini's OpenAI-compatible
# endpoint (fed only the last user message, instructed never to answer it).
# Falls back to a small static phrase list if that call fails or times out.
# Left unset, filler_words stays off entirely -- it does NOT fall back to
# the old static-only mode already proven to fight the speak-gate.
GEMINI_API_KEY=

# Optional, all three required together, AND GEMINI_API_KEY above must also
# be set. Together these start a SECOND, independent Agora agent -- its own
# voice, its own face, its own native-Gemini conversational loop -- joining
# the call alongside Watcher to stand in for a resolved approver who
# approved but couldn't personally join (see iCall's GET .../delegate and
# iOrchestrate's approve_delegate flow). It is not a change to Watcher's
# own session or persona; Watcher keeps doing its own job unchanged. No
# vendor has real credentials in this project yet; left unset (or with
# GEMINI_API_KEY missing), delegate calls still work -- Watcher's own
# greeting speaks the approver's notes instead -- just without a second,
# independent avatar in the room. GenericAvatar is vendor-agnostic -- point
# AVATAR_API_BASE_URL at whichever avatar provider you actually have an
# account with.
AVATAR_API_KEY=
AVATAR_API_BASE_URL=
AVATAR_ID=
