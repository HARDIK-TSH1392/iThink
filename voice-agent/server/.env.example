AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate
PORT=8000

# iThink-specific, not part of the upstream Agora quickstart. Base URL of
# the iThink backend (the repo's backend/ service) — agent.py builds the
# per-channel custom-LLM URL from this: {base}/icall/channel/{channel}/llm/chat/completions.
# Defaults to http://127.0.0.1:8123/api/v1 if unset.
ITHINK_BACKEND_BASE_URL=http://127.0.0.1:8123/api/v1

# Override the full custom-LLM URL directly instead of deriving it from
# ITHINK_BACKEND_BASE_URL — leave unset unless you have a specific reason to.
ITHINK_LLM_URL=

# Static key sent as the CustomLLM api_key. iCall's endpoint doesn't check
# it today, so any placeholder value works — kept as a real setting rather
# than hardcoded "unused" so it's easy to wire up auth later without a
# code change.
ITHINK_LLM_API_KEY=unused
